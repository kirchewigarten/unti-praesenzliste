// Zugriff nur für angemeldete Konten — Selbstregistrierung ist nicht vorgesehen, Konten
// legt eine Leitungsperson manuell in der Firebase-Konsole an (Authentication → Nutzer
// hinzufügen). Das reicht als Zugriffsschutz, weil es keinen öffentlichen Anmelde-Weg gibt.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
