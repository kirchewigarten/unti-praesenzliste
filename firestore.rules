// Zugriff nur für das eine gemeinsame Master-Konto (nicht nur "irgendein angemeldetes
// Konto"): Da der Firebase-apiKey im öffentlichen Client-Code liegt, kann sich über die
// Identity-Toolkit-REST-API grundsätzlich jede und jeder ein eigenes Konto anlegen — die
// UID-Prüfung verhindert, dass ein solches Fremdkonto Zugriff auf die Daten bekommt.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'HeTNMCa3ZJSc72NMikodldzDFHs2';
    }
  }
}
